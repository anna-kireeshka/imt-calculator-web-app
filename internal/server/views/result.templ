package views

// Result — итог расчёта: ИМТ, норма калорий и БЖУ на одном экране.
// Разметка следует макету pokazateli: секции с меткой-заголовком, крупное
// значение ИМТ рядом с бейджем зоны и шкала с указателем-пузырём.
templ Result(page Page) {
	@Layout(page) {
		<div class="stack">
			<h1 class="page-title">Ваши показатели</h1>
			<section class="section">
				<p class="section-label">Индекс массы тела</p>
				<div class="bmi-row" aria-live="polite">
					<span class="bmi-value" id="bmi-value">—</span>
					<span class="badge" id="bmi-zone">Нет данных</span>
				</div>
				<div class="scale" aria-hidden="true">
					<div class="scale__track">
						<div class="scale__pin" id="bmi-pin" hidden>
							<span class="scale__bubble" id="bmi-bubble"></span>
							<span class="scale__arrow"></span>
							<span class="scale__line"></span>
						</div>
					</div>
					<div class="scale__bar">
						<span class="scale__seg scale__seg--low"></span>
						<span class="scale__seg scale__seg--ok"></span>
						<span class="scale__seg scale__seg--warn"></span>
						<span class="scale__seg scale__seg--bad"></span>
					</div>
					// Подписи стоят под границами сегментов, а не по краям:
					// иначе цифра указывала бы не на тот цвет.
					<div class="scale__ticks">
						<span class="scale__tick scale__tick--low">18,5</span>
						<span class="scale__tick scale__tick--ok">25</span>
						<span class="scale__tick scale__tick--warn">30</span>
						<span class="scale__tick scale__tick--bad">40</span>
					</div>
				</div>
			</section>
			<section class="section section--tight" aria-live="polite">
				<div class="kcal">
					<span class="kcal__label" id="cal-target-label">Ваша норма</span>
					<span class="kcal__value">
						<span class="kcal__number" id="cal-target">—</span>
						<span class="kcal__unit">ккал</span>
					</span>
				</div>
			</section>
			<section class="section">
				<p class="section-label">БЖУ в день</p>
				<div class="macros">
					<div class="macro macro--protein">
						<span class="macro__name">Белки</span>
						<span class="macro__range" id="cal-protein">—</span>
						<span class="macro__unit">г</span>
					</div>
					<div class="macro macro--fat">
						<span class="macro__name">Жиры</span>
						<span class="macro__range" id="cal-fat">—</span>
						<span class="macro__unit">г</span>
					</div>
					<div class="macro macro--carb">
						<span class="macro__name">Углеводы</span>
						<span class="macro__range" id="cal-carbs">—</span>
						<span class="macro__unit">г</span>
					</div>
				</div>
			</section>
			<p class="error-text" id="result-error" role="alert"></p>
			<a class="btn-quiet" href="/onboarding">Изменить данные</a>
		</div>
	}
}
